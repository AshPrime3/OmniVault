# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB
MONGO_URI=mongodb://localhost:27017/securevault

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# AWS S3 (leave empty for local filesystem storage)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=securevault-files

# AI — Groq API (optional — get a FREE key at https://console.groq.com)
# Leave empty to use the built-in rule-based fallback (no AI call made)
GROQ_API_KEY=your_groq_api_key_here
